# Copie para ".env" e preencha. O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Endereço público da API (aponte o DNS para o IP da máquina). Sem domínio, para testar: 54-12-34-56.sslip.io
DOMINIO=api.seudominio.com.br

# Supabase → botão "Connect" → "Session pooler" (funciona em redes só IPv4, como a padrão da AWS).
# Copie host e usuário exatamente como aparecem no painel.
ConnectionStrings__Padrao=Host=aws-0-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.SEU_PROJECT_REF;Password=SUA_SENHA_DO_BANCO;SSL Mode=Require;Maximum Pool Size=10

# Chave dos logins: texto aleatório com 32+ caracteres (gere com: openssl rand -base64 48)
Jwt__Chave=TROQUE-POR-UM-TEXTO-ALEATORIO-LONGO

# Pluggy (Open Finance)
Pluggy__ClientId=
Pluggy__ClientSecret=
Pluggy__Sandbox=true
Pluggy__UrlPublicaApi=https://api.seudominio.com.br
Pluggy__SegredoWebhook=TROQUE-POR-OUTRO-TEXTO-ALEATORIO

# Endereço do front (Vercel)
Cors__Origens__0=https://seu-front.vercel.app

# Em produção com clientes reais, desligue o modo apresentação
Simulacao__Habilitada=true
Demo__Habilitado=true
