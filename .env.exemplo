# Variáveis da KOGNIT API. No Render elas são criadas pelo render.yaml (algumas você cola na tela).
# Para rodar NA SUA MÁQUINA apontando para o Supabase: copie para ".env", preencha e carregue antes do "dotnet run".
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

BancoDeDados__Provedor=Postgres
# Supabase → botão "Connect" → "Session pooler". Copie host e usuário exatamente como aparecem no painel.
ConnectionStrings__Padrao=Host=aws-0-us-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.SEU_PROJECT_REF;Password=SUA_SENHA_DO_BANCO;SSL Mode=Require;Maximum Pool Size=10

# Segredo dos logins (20+ caracteres). Gere com: openssl rand -base64 32
Jwt__Chave=TROQUE-POR-UM-TEXTO-ALEATORIO

# Pluggy (Open Finance)
Pluggy__ClientId=
Pluggy__ClientSecret=
Pluggy__Sandbox=true
# Endereço público da API (para o webhook). No Render é preenchido sozinho; localmente, só com um túnel (ex.: ngrok).
Pluggy__UrlPublicaApi=
Pluggy__SegredoWebhook=TROQUE-POR-OUTRO-TEXTO-ALEATORIO

# Endereço do front
Cors__Origens__0=http://localhost:5173
